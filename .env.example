# FLAG THEFT AUTO — Environment Configuration
# Copy to .env and fill in values before running

# ── CTFd Backend ──────────────────────────────────────────────────────────────
# Secure secret key for CTFd session signing (change before any deployment)
CTFD_SECRET_KEY=change_this_to_a_long_random_string_before_production

# CTFd admin token for the challenge importer (get from CTFd admin panel)
# NEVER commit a real token to version control
CTFD_TOKEN=your_admin_token_here

# CTFd base URL for the importer script
CTFD_URL=http://localhost:8000

# ── Bonus Wave auto-reveal ────────────────────────────────────────────────────
# The 10 bonus challenges are imported HIDDEN, then the `bonus-reveal` container
# flips them visible at T+offset. Set the event start (ISO-8601, with timezone):
EVENT_START=2026-11-25T10:00:00+05:30
# Minutes after EVENT_START to reveal the wave (default 60)
BONUS_REVEAL_OFFSET_MINUTES=60
# Or skip EVENT_START and pin an absolute reveal time instead:
# BONUS_REVEAL_AT=2026-11-25T11:00:00+05:30

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=ctfd_heist_2024_change_me

# ── Frontend ──────────────────────────────────────────────────────────────────
# In development: Vite proxy handles /api -> localhost:8000
# In production: same-origin via Nginx (leave empty for relative URLs)
VITE_CTFD_URL=

# ── Production TLS (docker-compose.prod.yml only) ─────────────────────────────
# Public hostname the Let's Encrypt certificate is issued for. nginx serves this
# name on :443 and redirects :80 -> :443 (except /.well-known/acme-challenge/).
# Leave unset for the local HTTP dev stack (docker-compose.yml).
DOMAIN=ctf.example.com

# CTFd gunicorn worker count. Keep at 2 on a 1 GB EC2 t3.micro to avoid OOM; 4 is
# fine with more RAM. (Production stack only; dev compose hard-codes 4.)
CTFD_WORKERS=2
